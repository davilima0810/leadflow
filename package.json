{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @leadflow/web dev",
    "dev:api": "pnpm --filter @leadflow/api dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "start:web": "pnpm --filter @leadflow/web start",
    "start:api": "pnpm --filter @leadflow/api start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
